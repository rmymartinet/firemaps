# Public URL used for canonical links after deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection used only on the server by Prisma.
# Never prefix this variable with NEXT_PUBLIC_.
# Must be Neon's direct (unpooled) connection, not the PgBouncer pooled one:
# the community-report realtime relay keeps a LISTEN connection open, which
# PgBouncer in transaction mode does not support reliably.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional e-mails used for password reset links.
# AUTH_EMAIL_FROM must use a sender/domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Firemaps <no-reply@example.com>

# Free server-side key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Never prefix this variable with NEXT_PUBLIC_.
NASA_FIRMS_MAP_KEY=

# Server-side web discovery of public TikTok/Instagram links.
# Create a key at https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# OAuth client created in the Copernicus Data Space dashboard.
# Keep both values server-side and never prefix them with NEXT_PUBLIC_.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# EUMETSAT Data Store OAuth credentials (kept for EUMETSAT catalogue/download APIs).
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
EUMETSAT_API_TOKEN=

# MTG-FRP ListProduct files are currently distributed by LSA SAF with a
# separate Basic account. The EUMETSAT API token cannot replace these values.
LSASAF_USERNAME=
LSASAF_PASSWORD=
