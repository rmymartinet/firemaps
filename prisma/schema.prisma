generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CommunityReportCategory {
  FLAMES
  SMOKE
  ROAD
  RESPONSE
  EVACUATION
  OTHER
}

enum CommunityReportModerationStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum CommunityMediaType {
  PHOTO
  VIDEO
  TIKTOK
  INSTAGRAM
  EXTERNAL_VIDEO
}

enum CommunityMediaStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

model CommunityReport {
  id               String                          @id @default(uuid()) @db.Uuid
  category         CommunityReportCategory
  description      String                          @default("") @db.VarChar(500)
  latitude         Decimal                         @db.Decimal(9, 6)
  longitude        Decimal                         @db.Decimal(9, 6)
  accuracyMeters   Int?
  directionType    String?                         @db.VarChar(32)
  directionDegrees Int?
  observedZone     Json?
  capturedAt       DateTime                        @db.Timestamptz(3)
  expiresAt        DateTime                        @db.Timestamptz(3)
  moderationStatus CommunityReportModerationStatus @default(PENDING)
  reporterId       String?                         @db.VarChar(128)
  reporterIpHash   String?                         @db.VarChar(64)
  createdAt        DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                        @updatedAt @db.Timestamptz(3)
  media            CommunityMedia[]
  votes            CommunityVote[]
  reporter         User?                           @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([moderationStatus, expiresAt])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([reporterId, createdAt])
  @@index([reporterIpHash, createdAt])
}

model User {
  id            String            @id @db.VarChar(128)
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false)
  image         String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  reports       CommunityReport[]

  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(128)
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.VarChar(128)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(128)
  accountId             String
  providerId            String
  userId                 String    @db.VarChar(128)
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt  DateTime? @db.Timestamptz(3)
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(3)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @db.VarChar(128)
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime? @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model CommunityMedia {
  id         String               @id @default(uuid()) @db.Uuid
  reportId   String               @db.Uuid
  type       CommunityMediaType
  status     CommunityMediaStatus @default(PENDING)
  url        String               @db.Text
  storageKey String?              @unique @db.VarChar(512)
  mimeType   String?              @db.VarChar(128)
  sizeBytes  Int?
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime             @updatedAt @db.Timestamptz(3)
  report     CommunityReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
}

model CommunityVote {
  id           String          @id @default(uuid()) @db.Uuid
  reportId     String          @db.Uuid
  voterId      String          @db.VarChar(128)
  value        Int
  voterIpHash  String?         @db.VarChar(64)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  report       CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, voterId])
  @@index([reportId, value])
  @@index([voterIpHash, createdAt])
}
